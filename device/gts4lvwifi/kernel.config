# Extra options on top of arch/arm64/configs/defconfig and sdm670.config.
# The shared SDM670 fragment stays in the kernel tree. Add a line here only
# when this tablet needs an option that fragment must not carry.
CONFIG_LOCALVERSION="-gts4lvwifi"
# Bootloader splash. sdm670.config leaves DRM modular, so this stays a
# module and the initramfs loads it. =y would require turning DRM built-in.
CONFIG_DRM_SIMPLEDRM=m
# The DTS ramoops region at 0xa1300000 matches Lineage, which reads it
# from /sys/fs/pstore. A module never attaches before init, and init has
# not been reached over USB. Built-in console capture is the one change
# that can explain the next black boot.
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# The SM5705 MUIC sits on the bit-banged "i2c-charger" bus (DTS i2c-gpio,
# TLMM 43/44). sdm670.config turns I2C_GPIO off, so that bus is never
# created and init cannot write MANSW1=0x24: D+/D- stay off the SoC and the
# host sees no 18d1:d001 although the gadget is bound. Built-in, not a
# module: init looks for the bus about a second into boot, before any
# module would be loaded.
CONFIG_I2C_GPIO=y
# pacman 7 sandboxes its downloads with Landlock and stops with "Landlock is
# not supported by the kernel" without it. CONFIG_LSM already names landlock
# first, so the option is all that is missing.
CONFIG_SECURITY_LANDLOCK=y
# Android's userdata ext4 enables the V2 quota feature.  The recovery shell
# mounts it directly only to replace rootfs.img, so without this built-in
# parser ext4 refuses the superblock before the guarded installer can run.
CONFIG_QFMT_V2=y
# Modules for the subsystems the device tree already describes and the build
# lacked (docs/HARDWARE-MATRIX.md, PORTING-ROADMAP.md). All modules, none loaded
# at boot: the rootfs blacklists or never autoloads them, and each is tried by
# hand. uinput is for the touch daemon; there is no kernel driver for the
# touchscreen in this tree.
CONFIG_INPUT_UINPUT=m
CONFIG_DRM_PANEL_SAMSUNG_ANA38401=m
CONFIG_SND_SOC_CS35L41_I2C=m
CONFIG_BATTERY_SM5705=m
CONFIG_VIDEO_S5K3M5=m
CONFIG_VIDEO_S5K4HA=m

# Wi-Fi bring-up: ath10k's own debug messages (module parameter debug_mask).
# Only the ath10k modules change; vmlinux stays the same.
CONFIG_ATH10K_DEBUG=y

# Touchscreen (STM FTS1BA90A): our own driver, device/gts4lvwifi/kernel. A
# module, listed in the blacklist until it is trusted at boot.
CONFIG_TOUCHSCREEN_FTS1BA90A=m
