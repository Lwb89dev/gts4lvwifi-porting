# Extra options on top of arch/arm64/configs/defconfig and sdm670.config.
# The shared SDM670 fragment stays in the kernel tree. Add a line here only
# when this tablet needs an option that fragment must not carry.
CONFIG_LOCALVERSION="-gts4lvwifi"
# Bootloader splash. sdm670.config leaves DRM modular, so this stays a
# module and the initramfs loads it. =y would require turning DRM built-in.
CONFIG_DRM_SIMPLEDRM=m
