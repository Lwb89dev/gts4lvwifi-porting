#!/bin/busybox sh
# First light: USB network (NCM + RNDIS), ACM serial, telnet shell.
# Does not write eMMC. Does not reboot.

/bin/busybox mkdir -p /bin /sbin /usr/bin /usr/sbin /proc /sys /dev /tmp /run /lib/modules
/bin/busybox --install -s

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
mount -t configfs configfs /sys/kernel/config

log() {
	echo "gts4lv-init: $*" > /dev/kmsg
}

part() {
	for uevent in /sys/class/block/mmcblk0p*/uevent; do
		grep -q "^PARTNAME=$1\$" "$uevent" 2>/dev/null || continue
		basename "$(dirname "$uevent")"
		return 0
	done
	return 1
}

# The Arch Linux ARM root is a file in Android's userdata. dm-linear maps its
# extents (a list baked into this initramfs) over the raw partition, so /data
# is never mounted. Returns, and the USB shell stays, whenever something is
# missing or the last attempt never finished (/boot-attempt still there).
try_arch() {
	[ -s /etc/rootfs-extents.txt ] || { log "arch: no rootfs baked in"; return 1; }
	if grep -qw gts4lv.stay /proc/cmdline; then
		log "arch: staying (gts4lv.stay)"
		return 1
	fi
	userdata=$(part userdata) || { log "arch: no userdata partition"; return 1; }
	insmod /lib/modules/dm-mod.ko || { log "arch: insmod dm-mod failed"; return 1; }
	i=0
	while [ ! -c /dev/mapper/control ] && [ "$i" -lt 10 ]; do
		sleep 1
		i=$((i + 1))
	done
	devno=$(dmlinear arch "/dev/$userdata" /etc/rootfs-extents.txt) ||
		{ log "arch: dmlinear failed"; return 1; }
	node=/dev/dm-${devno#*:}
	mkdir -p /mnt/root
	mount -t ext4 -o rw,noatime "$node" /mnt/root ||
		{ log "arch: no ext4 on $node ($devno)"; return 1; }
	if [ ! -x /mnt/root/usr/lib/systemd/systemd ]; then
		log "arch: no systemd in the root"
		umount /mnt/root
		return 1
	fi
	if [ -e /mnt/root/boot-attempt ]; then
		log "arch: the last attempt never finished, staying"
		umount /mnt/root
		return 1
	fi
	: > /mnt/root/boot-attempt
	sync
	log "GTS4LV-SWITCHROOT"
	# the unauthenticated shells of this initramfs must not live on in Arch
	killall telnetd udhcpd 2>/dev/null
	for m in dev proc sys run; do
		mount --move "/$m" "/mnt/root/$m"
	done
	# exec: switch_root insists on being PID 1, and a child of this shell is
	# not. If it fails PID 1 dies, the kernel panics and reboots after
	# panic=10 s, and /boot-attempt keeps the next boot in the USB shell.
	exec switch_root /mnt/root /usr/lib/systemd/systemd
}

log "up, kernel $(uname -r)"

# Order is modules.dep for 7.2.13-gts4lvwifi. simpledrm first: a splash
# means this init ran, even when the gadget never enumerates.
# phy-qcom-qusb2 has no dependencies. dwc3 is built-in and defers until
# this module registers the USB2 PHY.
for mod in backlight drm drm_kms_helper drm_client_lib \
	drm_sysfb_helper drm_shmem_helper simpledrm \
	phy-qcom-qusb2 \
	libcomposite u_serial usb_f_acm u_ether usb_f_ncm usb_f_rndis
do
	insmod /lib/modules/$mod.ko || log "insmod $mod failed"
done

IP=172.16.42.1
G=/sys/kernel/config/usb_gadget/g1
if mkdir -p "$G" && cd "$G"; then
	echo 0x18d1 > idVendor
	echo 0xd001 > idProduct
	mkdir -p strings/0x409
	echo Samsung > strings/0x409/manufacturer
	echo "gts4lvwifi first light" > strings/0x409/product
	if ! tr -d '\000' < /proc/device-tree/serial-number > strings/0x409/serialnumber 2>/dev/null; then
		echo gts4lvwifi > strings/0x409/serialnumber
	fi
	mkdir -p configs/c.1/strings/0x409
	echo "NCM+RNDIS+ACM" > configs/c.1/strings/0x409/configuration
	echo 500 > configs/c.1/MaxPower
	for fn in ncm.usb0 rndis.usb0 acm.usb0; do
		mkdir -p functions/$fn
		ln -s functions/$fn configs/c.1/
	done
	cd /
	i=0
	udc=
	while [ "$i" -lt 60 ]; do
		udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
		[ -n "$udc" ] && break
		i=$((i + 1))
		sleep 1
	done
	if [ -n "$udc" ] && echo "$udc" > "$G/UDC"; then
		log "gadget bound to $udc"
	else
		log "no UDC"
	fi
else
	log "configfs gadget failed"
fi

bus=
for dev in /sys/bus/i2c/devices/i2c-*; do
	name=$(cat "$dev/of_node/name" 2>/dev/null) || continue
	[ "$name" = i2c-charger ] || continue
	base=$(basename "$dev")
	bus=${base#i2c-}
	break
done
if [ -n "$bus" ] && /usr/sbin/muic-usb "$bus"; then
	log "muic usb on i2c-$bus"
else
	log "muic not switched"
fi

ip link set lo up
ip link set usb0 up 2>/dev/null
ip link set usb1 up 2>/dev/null
ip addr add "$IP/24" dev usb0 2>/dev/null && log "usb0 $IP"

cat > /tmp/udhcpd.conf <<EOF
start 172.16.42.2
end 172.16.42.2
interface usb0
option subnet 255.255.255.0
max_leases 1
lease_file /tmp/udhcpd.leases
EOF
touch /tmp/udhcpd.leases
udhcpd /tmp/udhcpd.conf
telnetd -l /bin/sh -b "$IP"
log "telnet $IP"

# qcom-pon writes the PMIC restart reason and makes restarts a hard reset.
# Loaded after the USB shell is up so the path that was proved does not
# change. boot-android and rebootmode use it. No dependencies.
if insmod /lib/modules/qcom-pon.ko; then
	if [ -e /sys/class/reboot-mode/qcom-pon ]; then
		log "qcom-pon loaded, reboot-mode ready"
	else
		log "qcom-pon loaded, reboot-mode missing"
	fi
else
	log "insmod qcom-pon failed"
fi

try_arch || log "arch: not started, the USB shell stays"

while true; do
	if [ -c /dev/ttyGS0 ]; then
		setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'
	fi
	sleep 1
done
