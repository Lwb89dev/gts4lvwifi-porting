# Wi-Fi is an ordinary DHCP client when the owner elects to use the minimal
# wpa_supplicant path. Omarchy Mobile uses NetworkManager by default; its
# connection profiles stay on the tablet and never go in this repository.
# This networkd definition remains a small no-profile fallback for a manual
# wpa_supplicant@wlan0 setup.
# The cable (usb0, 10-usb0.network) keeps its own address; the route over
# Wi-Fi gets a higher metric so a Wi-Fi default route never replaces the cable's.
[Match]
Name=wlan0

[Link]
# not associated until the owner gives credentials: boot must not wait for it
RequiredForOnline=no

[Network]
DHCP=yes
IPv6AcceptRA=yes

[DHCPv4]
RouteMetric=600
