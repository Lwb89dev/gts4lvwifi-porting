# Gets the speakers ready for an audio server (ADSP, LPI pins, the amplifiers' protection
# firmware, the route, and the volume read back and capped at -12 dB). Omarchy enables this
# before SDDM so PipeWire probes the PCM only after it is usable. The sensor stack already
# requires the ADSP at boot; gts4lv-adsp-stop.service stops it at a normal shutdown.
[Unit]
Description=Speakers ready for the audio server (ADSP, protection, route)
Requires=gts4lv-firmware.service gts4lv-sensors.service
After=gts4lv-firmware.service gts4lv-modem.service gts4lv-sensors.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
ExecStart=/usr/local/sbin/gts4lv-audio start
ExecStop=/usr/local/sbin/gts4lv-audio stop

[Install]
WantedBy=multi-user.target
