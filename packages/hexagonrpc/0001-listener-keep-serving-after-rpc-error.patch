From: gts4lvwifi-porting maintainers
Subject: [PATCH] listener: keep serving after reporting an RPC error

invoke_requested_procedure() stores an AEE error in result when a request is
unsupported or malformed.  Keep the listener alive so return_for_next_invoke()
can report that error to the DSP instead of tearing down the sensors process.

---
 hexagonrpcd/listener.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/hexagonrpcd/listener.c b/hexagonrpcd/listener.c
index 3414974..891fcf4 100644
--- a/hexagonrpcd/listener.c
+++ b/hexagonrpcd/listener.c
@@ -308,12 +308,21 @@ int run_fastrpc_listener(int fd,
 
 		if (returned != NULL)
 			iobuf_free(n_outbufs, returned);
+		returned = NULL;
 
 		ret = invoke_requested_procedure(n_ifaces, ifaces,
 						 handle, sc, &result,
 						 decoded, &returned);
-		if (ret)
-			break;
+		if (ret) {
+			/* Report the error to the DSP and keep serving. */
+			if (decoded != NULL)
+				iobuf_free(REMOTE_SCALARS_INBUFS(sc), decoded);
+			decoded = NULL;
+			sc = REMOTE_SCALARS_MAKE(0, 0, 0);
+			n_outbufs = 0;
+			ret = 0;
+			continue;
+		}
 
 		if (decoded != NULL)
 			iobuf_free(REMOTE_SCALARS_INBUFS(sc), decoded);
-- 
