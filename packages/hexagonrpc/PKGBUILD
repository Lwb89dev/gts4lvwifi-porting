# SPDX-License-Identifier: GPL-3.0-only
# hexagonrpcd: the FastRPC daemon the sensor core on the ADSP talks to. GPL-3.0
# upstream, so it stays a separate package and nothing here links to it.
pkgname=hexagonrpc
pkgver=0.5.0
pkgrel=1
pkgdesc="FastRPC daemon for the Qualcomm Hexagon DSPs (hexagonrpcd)"
arch=(aarch64)
url="https://github.com/linux-msm/hexagonrpc"
license=(GPL-3.0-only)
depends=(glibc)
makedepends=(meson)
source=("$pkgname-v$pkgver.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2173985932ab68d8ac593f9954357123bdbbbe9ba5f1b17a098d9cbcec22c5d5')

build() {
  meson setup build "$pkgname-$pkgver" --prefix=/usr --libexecdir=lib \
    --sbindir=bin --buildtype=plain
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "$pkgname-$pkgver/COPYING" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
