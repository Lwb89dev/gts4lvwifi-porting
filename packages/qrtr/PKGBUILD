# SPDX-License-Identifier: BSD-3-Clause
# Userspace for the Qualcomm IPC router (net/qrtr): libqrtr, the name service
# qrtr-ns and the qrtr-cfg and qrtr-lookup tools. Arch Linux ARM does not
# package it; the modem, ADSP and sensor services below all need it.
pkgname=qrtr
pkgver=1.2
pkgrel=1
pkgdesc="Qualcomm IPC router userspace: libqrtr, qrtr-ns, qrtr-cfg, qrtr-lookup"
arch=(aarch64)
url="https://github.com/linux-msm/qrtr"
license=(BSD-3-Clause)
depends=(glibc)
makedepends=(meson)
source=("$pkgname-v$pkgver.tar.gz::https://github.com/linux-msm/qrtr/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7a82bf80246fe71287b13c66c0466208822e8337fcd4aaf302eee6c5fcb48a52')

build() {
  meson setup build "$pkgname-$pkgver" --prefix=/usr --libexecdir=lib \
    --sbindir=bin --buildtype=plain -Dqrtr-ns=enabled -Dsystemd-service=enabled
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "$pkgname-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
