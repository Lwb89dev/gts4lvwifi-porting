# SPDX-License-Identifier: BSD-3-Clause
# The Qualcomm remote filesystem service: the modem asks for its storage
# partitions (modemst1, modemst2, fsg, fsc) through qrtr. The unit that
# upstream ships runs "rmtfs -r -P -s": -r keeps writes in a RAM shadow buffer,
# so the tablet's own partitions are only read, never written.
pkgname=rmtfs
pkgver=1.3
pkgrel=1
pkgdesc="Qualcomm remote filesystem service (read-only on the partitions with -r)"
arch=(aarch64)
url="https://github.com/linux-msm/rmtfs"
license=(BSD-3-Clause)
depends=(glibc qrtr systemd-libs)
source=("$pkgname-v$pkgver.tar.gz::https://github.com/linux-msm/rmtfs/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4b6c398806a1046e2256a685d592833de0f37b7245b8adc4797e1791f0e117ee')

build() {
  make -C "$pkgname-$pkgver" prefix=/usr
}

package() {
  make -C "$pkgname-$pkgver" prefix=/usr DESTDIR="$pkgdir" install
  install -Dm644 "$pkgname-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
