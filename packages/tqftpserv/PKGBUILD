# SPDX-License-Identifier: BSD-3-Clause
# TFTP server over AF_QIPCRTR: the modem DSP fetches its own files (Wi-Fi board
# data, calibration) from the filesystem through it.
pkgname=tqftpserv
pkgver=1.3
pkgrel=1
pkgdesc="Trivial File Transfer Protocol server over AF_QIPCRTR"
arch=(aarch64)
url="https://github.com/linux-msm/tqftpserv"
license=(BSD-3-Clause)
depends=(glibc qrtr xz zstd)
makedepends=(meson)
source=("$pkgname-v$pkgver.tar.gz::https://github.com/linux-msm/tqftpserv/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('87a3845e8f47b42f31d8aaad04c5e0707e391b3954d096aeff6f0a03467dc33f')

build() {
  meson setup build "$pkgname-$pkgver" --prefix=/usr --libexecdir=lib \
    --sbindir=bin --buildtype=plain
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "$pkgname-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
